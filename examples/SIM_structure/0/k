FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.001;

boundaryField
{
    person1
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    person2
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    dip3
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    dip5
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    table7
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    wall9
    {
        type            kqRWallFunction;
        value           $internalField;
    }
    inlet4
    {
        type            fixedValue;
        value           uniform 0.00375;
    }
    inlet6
    {
        type            fixedValue;
        value           uniform 0.00375;
    }
    outlet8
    {
        type            inletOutlet;
        inletValue      $internalField;
    }
}


