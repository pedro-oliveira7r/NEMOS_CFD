FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    person1
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    person2
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    dip3
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    dip5
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    table7
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    wall9
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    inlet4
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    inlet6
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    outlet8
    {
        type            prghPressure;
        p               $internalField;
        value           $internalField;
    }
}


